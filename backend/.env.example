# ===========================================
# StackSage Backend - Environment Configuration
# ===========================================

# --- LLM Provider ---
# LLM_PROVIDER selects which of the keys below is used: groq | openrouter | gemini
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# --- Storage (all persisted to disk) ---
CHROMA_PERSIST_DIR=./data/chromadb
STATE_PERSIST_DIR=./data/state
REPO_STORAGE_DIR=./data/repos
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Repository Limits ---
MAX_FILE_SIZE_KB=500
MAX_REPO_FILES=5000

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Rate Limiting ---
RATE_LIMIT_RPM=30
AGENT_DELAY_SECONDS=4.0
